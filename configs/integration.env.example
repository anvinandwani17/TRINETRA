# Add these to your private project-root .env. Do not commit real keys.
# Free key: https://account.heigit.org/
OHSOME_API_KEY=
OHSOME_API_URL=https://api.heigit.org/ohsome-api/v2-rc
# Optional. Default is the latest verified snapshot before the event date.
# TRINETRA_OSM_SNAPSHOT=2026-08-25T00:00:00Z
# Optional local case folder override. Default: data/processed/trishuli
# TRINETRA_CASE_DIR=C:\path\to\processed\trishuli
TRINETRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional fresh processing and experimental methods; use actual local paths.
# SNAP_GPT=C:\Program Files\esa-snap\bin\gpt.exe
# TRINETRA_AI_CHECKPOINT=C:\path\to\pilot\best.pt
# TRINETRA_AI_RUN_CONFIG=C:\path\to\pilot\run_config.json
# TRINETRA_HAND_SOURCE_CASE_DIR=C:\path\to\original\data\processed\trishuli
